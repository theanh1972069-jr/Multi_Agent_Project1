# Application environment
APP_ENV=development

# Database (SQLite local default; uncomment PostgreSQL for Docker Compose)
DATABASE_URL=sqlite:///./data/diabetes_app.db
# DATABASE_URL=postgresql+psycopg://diabetes:diabetes@localhost:5432/diabetes_app

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Provider (ollama default; switchable to gemini or openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=45

# Optional Cloud LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional Neo4j Knowledge Graph (falls back to local JSON mirror when unset/unreachable)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Storage & Model Artifact Paths (relative to repository root)
CHROMA_PERSIST_DIR=data/chroma_kb
KG_MIRROR_PATH=data/knowledge_graph/diabetes_kg.json
MODEL_ARTIFACT_PATH=ml_pipeline/artifacts/nhanes_hba1c_v2.joblib
MODEL_MANIFEST_PATH=ml_pipeline/artifacts/model_manifest.json
UPLOAD_DIR=data/uploads

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
